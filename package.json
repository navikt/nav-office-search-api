{
	"name": "nav-office-search-api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#server/*": "./server/*",
		"#test/*": "./test/*"
	},
	"scripts": {
		"build": "node build/main.ts",
		"dev": "node --env-file=.env.development --import ./test/mocks/dev.ts --watch server/main.ts",
		"format": "oxfmt",
		"lint": "oxfmt --check && oxlint && tsc --noEmit",
		"start": "node server/main.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@hono/node-server": "2.1.6",
		"@itsy/corgi": "1.4.1",
		"@navikt/navno-logger": "1.2.0",
		"@prometheus-io/client": "0.16.1",
		"croner": "11.0.0",
		"hono": "4.13.17",
		"ufo": "1.6.4",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"lefthook": "2.2.2",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2007",
		"pino-pretty": "13.2.0",
		"typescript": "6.0.3",
		"vitest": "5.1.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "26"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
