{
  "name": "nav-office-search-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
  "type": "module",
  "module": "es",
  "scripts": {
    "build": "rm -fr distSrc && tsc",
    "dev": "tsc && (tsc -w --preserveWatchOutput &) && node --watch-path=distSrc -r dotenv/config distSrc/server.js",
    "lint": "eslint src/",
    "start": "node distSrc/server.js",
    "test": "pnpm run build && pnpm run test:run",
    "test:run": "node --test tests/*.test.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "express": "4.22.1",
    "graphql": "16.14.2",
    "graphql-request": "7.4.0",
    "node-cache": "5.1.2",
    "node-schedule": "2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "4.17.21",
    "@types/node": "25.9.1",
    "@types/node-schedule": "2.1.8",
    "dotenv": "18.0.5",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
