{
	"name": "nav-office-search-api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#server/*": "./server/*",
		"#test/*": "./test/*"
	},
	"scripts": {
		"dev": "node --env-file=.env.development --import ./test/mocks/dev.ts --watch server/main.ts",
		"format": "oxfmt",
		"lint": "oxfmt --check && eslint . && tsc --noEmit",
		"start": "node server/main.ts",
		"test": "vitest run",
		"prepare": "husky || true"
	},
	"dependencies": {
		"@hono/node-server": "2.1.6",
		"@navikt/navno-logger": "1.2.0",
		"@prometheus-io/client": "0.16.1",
		"graphql": "16.14.2",
		"graphql-request": "7.4.0",
		"hono": "4.13.17",
		"node-cache": "5.1.2",
		"node-schedule": "2.1.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@itsy/corgi": "1.4.1",
		"@types/node": "26.6.5",
		"@types/node-schedule": "2.1.8",
		"eslint": "10.14.0",
		"husky": "9.1.7",
		"oxfmt": "0.78.0",
		"pino-pretty": "13.2.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vitest": "5.1.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "26"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
