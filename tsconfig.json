// Type-checks the source, the tests and the config files (`pnpm lint`). tsconfig.build.json does the build.
{
	"compilerOptions": {
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"lib": ["esnext", "dom"],
		"moduleResolution": "nodenext",
		"module": "nodenext",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "es2022",
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts"]
}
