// Type-check only (`pnpm lint`): Node runs the TypeScript in server/ directly, stripping the types
{
	"compilerOptions": {
		"target": "es2024",
		// dom: fetch.ts and pdl/token.ts read fetch's types from it, until PR 11
		"lib": ["es2024", "dom"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true
	},
	"include": ["server/**/*.ts", "test/**/*.ts", "*.config.ts"]
}
