// Type-check only (`pnpm lint`): Node runs the TypeScript in server/ and build/ directly, stripping the types
{
	"compilerOptions": {
		"target": "es2024",
		// dom: fetch.ts reads fetch's types from it, until the old NORG loader goes
		"lib": ["es2024", "dom"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true
	},
	"include": ["server/**/*.ts", "build/**/*.ts", "test/**/*.ts", "*.config.ts"]
}
